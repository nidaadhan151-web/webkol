rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /campaign-banners/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /topup-receipts/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9_-]+\\.jpg$')
        && request.resource.size <= 350 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
    }
  }
}
